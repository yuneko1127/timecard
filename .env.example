# ========== データベース設定 ==========
# 本番・PostgreSQL 利用時（例: Render / Railway / 自前 Postgres）
# DATABASE_URL=postgresql://ユーザー:パスワード@ホスト:5432/DB名
# Heroku/一部ホストの postgres:// でも可（アプリ側で postgresql:// に正規化）

# ========== Flask セッション設定 ==========
# 必ず変更（本番）
# 例: python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# ========== 初期アカウント設定 ==========
# DB初期化時に初期ユーザーを作成する（両方指定された場合のみ）
# INITIAL_LOGIN_ID=admin
# INITIAL_PASSWORD=secure_password_2024
